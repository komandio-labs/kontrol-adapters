{
  "adapterId": "space-engineers-2",
  "schemaVersion": 1,
  "categories": [
    {
      "name": "Flight Controls",
      "icon": "Spacecraft",
      "description": "Flight control translation mode and angular input mechanics."
    }
  ],
  "descriptors": [
    {
      "$type": "string",
      "defaultValue": "GameDefault",
      "allowedValues": [
        { "value": "GameDefault", "displayName": "Game Default (Default)", "description": "Follows the speed unit selected in Space Engineers 2's HUD." },
        { "value": "KilometersPerHour", "displayName": "Metric (km/h)", "description": "Displays speed in kilometres per hour." },
        { "value": "MilesPerHour", "displayName": "Imperial (mph)", "description": "Displays speed in miles per hour." }
      ],
      "key": "speedDisplayUnit",
      "displayName": "Speed Display Units",
      "category": "Flight Controls",
      "type": "String",
      "icon": "Gauge",
      "description": "Selects the final presentation unit for SE2 speed parameters. Game Default follows the SE2 HUD when telemetry is available.",
      "updateScope": "Realtime",
      "layout": "Full",
      "isReadOnly": false
    },
    {
      "$type": "string",
      "defaultValue": "DirectAngularFlight",
      "allowedValues": [
        {
          "value": "DirectAngularFlight",
          "displayName": "Direct Angular Flight (Default)",
          "description": "Direct rate-controlled angular velocity with smooth acceleration ramping and glide easing."
        },
        {
          "value": "NativeReticleSteering",
          "displayName": "Native Reticle Steering",
          "description": "Preserves Space Engineers 2\u0027s native virtual mouse-reticle steering and built-in crosshair dampening."
        }
      ],
      "key": "flightModelMode",
      "displayName": "Flight Control Mode",
      "category": "Flight Controls",
      "type": "String",
      "icon": "Spacecraft",
      "description": "Selects how joystick inputs are translated to ship controls.",
      "updateScope": "Realtime",
      "layout": "Full",
      "isReadOnly": false
    },
    {
      "$type": "number",
      "defaultValue": 1.3,
      "min": 0.1,
      "max": 5,
      "step": 0.1,
      "unit": "rad/s²",
      "canonicalUnit": "RadiansPerSecondSquared",
      "minLabel": "0.1 (Smooth Ramp)",
      "midLabel": "1.3 (Balanced)",
      "maxLabel": "5.0 (Instant)",
      "key": "directAngularAcceleration",
      "displayName": "Rotational Acceleration Ramp",
      "category": "Flight Controls",
      "type": "Number",
      "icon": "Clock",
      "description": "Controls how smoothly rotation accelerates up to full commanded rate when deflecting the stick.",
      "updateScope": "Realtime",
      "layout": "Half",
      "visibleWhen": {
        "dependsOnKey": "flightModelMode",
        "expectedValue": "DirectAngularFlight"
      },
      "isReadOnly": false
    },
    {
      "$type": "number",
      "defaultValue": 1,
      "min": 0.1,
      "max": 5,
      "step": 0.1,
      "unit": "rad/s²",
      "canonicalUnit": "RadiansPerSecondSquared",
      "minLabel": "0.1 (Long Glide)",
      "midLabel": "1.0 (Balanced)",
      "maxLabel": "5.0 (Quick Stop)",
      "key": "directAngularDeceleration",
      "displayName": "Rotational Glide Deceleration",
      "category": "Flight Controls",
      "type": "Number",
      "icon": "Inertia",
      "description": "Controls rotational glide easing when releasing the stick to center before coming to rest.",
      "updateScope": "Realtime",
      "layout": "Half",
      "visibleWhen": {
        "dependsOnKey": "flightModelMode",
        "expectedValue": "DirectAngularFlight"
      },
      "isReadOnly": false
    },
    {
      "$type": "number",
      "defaultValue": 0.85,
      "min": 0.1,
      "max": 3,
      "step": 0.05,
      "unit": "rad/s",
      "canonicalUnit": "RadiansPerSecond",
      "displayMultiplier": 57.29578,
      "displayUnit": "°/s",
      "presentationUnit": "DegreesPerSecond",
      "minLabel": "6 \u00B0/s",
      "midLabel": "49 \u00B0/s",
      "maxLabel": "172 \u00B0/s",
      "key": "directAngularMaxRate",
      "displayName": "Maximum Turn Rate Scaling",
      "category": "Flight Controls",
      "type": "Number",
      "icon": "Gyroscope",
      "description": "Scales maximum target angular velocity achieved at 100% full stick deflection.",
      "updateScope": "Realtime",
      "layout": "Half",
      "visibleWhen": {
        "dependsOnKey": "flightModelMode",
        "expectedValue": "DirectAngularFlight"
      },
      "isReadOnly": false
    },
    {
      "$type": "boolean",
      "defaultValue": true,
      "key": "showCruiseControlHudIndicator",
      "displayName": "Show Cruise Control HUD Indicator",
      "category": "Flight Controls",
      "type": "Boolean",
      "icon": "Gauge",
      "description": "Shows the cruise-control target-speed indicator in the SE2 cockpit HUD while Cruise Control is active.",
      "updateScope": "Realtime",
      "layout": "Full",
      "isReadOnly": false
    },
    {
      "$type": "string",
      "defaultValue": "VelocityHold",
      "allowedValues": [
        {
          "value": "DirectThrust",
          "displayName": "Direct Thrust",
          "description": "Uses the current shaped axis value as proportional thrust."
        },
        {
          "value": "VelocityHold",
          "displayName": "Velocity Hold (Default)",
          "description": "Uses the current shaped axis as a local target velocity and applies bounded signed feedback to reach it."
        }
      ],
      "key": "translationControlMode",
      "displayName": "Translation Control",
      "category": "Flight Controls",
      "type": "String",
      "icon": "Spacecraft",
      "description": "Independent of Flight Control Mode. Selects whether translation axes command thrust directly or target local ship velocity.",
      "updateScope": "Realtime",
      "layout": "Full",
      "isReadOnly": false
    },
    {
      "$type": "number",
      "defaultValue": 0,
      "min": 0,
      "max": 0,
      "step": 1,
      "runtimeRange": true,
      "unit": "m/s",
      "canonicalUnit": "MetersPerSecond",
      "displayMultiplier": 1,
      "displayUnit": "m/s",
      "presentationUnit": "MetersPerSecond",
      "presentationSourceKey": "speedDisplayUnit",
      "presentationVariants": {
        "GameDefault": { "unit": "MetersPerSecond", "multiplier": 1, "decimalPlaces": 0, "minimum": 0, "maximum": 0, "step": 1, "minLabel": "Runtime limit", "midLabel": "Waiting for SE2 grid limit", "maxLabel": "Waiting for SE2 grid limit" },
        "KilometersPerHour": { "unit": "KilometersPerHour", "multiplier": 3.6, "decimalPlaces": 0, "minimum": 0, "maximum": 0, "step": 1, "minLabel": "Runtime limit", "midLabel": "Waiting for SE2 grid limit", "maxLabel": "Waiting for SE2 grid limit" },
        "MilesPerHour": { "unit": "MilesPerHour", "multiplier": 2.2369363, "decimalPlaces": 0, "minimum": 0, "maximum": 0, "step": 1, "minLabel": "Runtime limit", "midLabel": "Waiting for SE2 grid limit", "maxLabel": "Waiting for SE2 grid limit" }
      },
      "minLabel": "Runtime limit",
      "midLabel": "Waiting for SE2 grid limit",
      "maxLabel": "Waiting for SE2 grid limit",
      "key": "velocityHoldMaxTargetSpeed",
      "displayName": "Velocity Hold Target-Speed Cap",
      "category": "Flight Controls",
      "type": "Number",
      "icon": "Gauge",
      "description": "Optional cap for Velocity Hold targets; 0 uses SE2's active grid soft limit or velocity-limit provider.",
      "updateScope": "Realtime",
      "layout": "Full",
      "visibleWhen": {
        "dependsOnKey": "translationControlMode",
        "expectedValue": "VelocityHold"
      },
      "isReadOnly": false
    },
    {
      "$type": "number",
      "defaultValue": 12,
      "min": 1,
      "max": 20,
      "step": 1,
      "unit": "×",
      "canonicalUnit": "Multiplier",
      "minLabel": "1 (Smooth)",
      "midLabel": "12 (Responsive)",
      "maxLabel": "20 (Aggressive)",
      "key": "velocityHoldResponseGain",
      "displayName": "Velocity Hold Response",
      "category": "Flight Controls",
      "type": "Number",
      "icon": "Gauge",
      "description": "Scales Velocity Hold feedback. Higher values keep thrust strong until closer to the target speed.",
      "updateScope": "Realtime",
      "layout": "Half",
      "visibleWhen": {
        "dependsOnKey": "translationControlMode",
        "expectedValue": "VelocityHold"
      },
      "isReadOnly": false
    }
  ]
}
