<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildProjectDirectory)\..\AdapterVersion.props" />
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Kontrol.Adapters.SpaceEngineers</AssemblyName>
    <Version>$(AdapterVersion)</Version>
    <AssemblyVersion>$(AdapterAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(AdapterAssemblyVersion)</FileVersion>
    <InformationalVersion>$(AdapterVersion)</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\ControlLayout.cs" Link="ControlLayout.cs" />
    <ProjectReference Include="..\..\..\Kontrol.Sdk\Kontrol.Sdk.csproj" />
    <None Include="adapter.manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Kontrol.Adapters.SpaceEngineers.Plugin\Kontrol.Adapters.SpaceEngineers.Plugin.xml" Link="Kontrol.Adapters.SpaceEngineers.Plugin.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildPulsarPayload" BeforeTargets="Build">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\Kontrol.Adapters.SpaceEngineers.Plugin\Kontrol.Adapters.SpaceEngineers.Plugin.csproj" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=net48" />
  </Target>
  <Target Name="CopyPulsarPayload" AfterTargets="Build" DependsOnTargets="BuildPulsarPayload">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\Kontrol.Adapters.SpaceEngineers.Plugin\bin\$(Configuration)\net48\Kontrol.Adapters.SpaceEngineers.Plugin.dll" DestinationFolder="$(TargetDir)" />
  </Target>
</Project>
