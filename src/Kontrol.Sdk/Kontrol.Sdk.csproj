<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Version>$(KontrolSdkVersion)</Version>
    <AssemblyVersion>$(KontrolSdkAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(KontrolSdkVersion)</FileVersion>
    <InformationalVersion>$(KontrolSdkVersion)</InformationalVersion>
    <Authors>Komandio Labs</Authors>
    <Company>Komandio Labs</Company>
    <Product>Kontrol</Product>
    <Copyright>Copyright © 2026 Komandio Labs</Copyright>
    <RepositoryUrl>https://github.com/komandio-labs/kontrol-adapters</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://www.komandio.com/kontrol</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Kontrol;game adapters;SDK;IPC</PackageTags>
    <Description>Shared SDK contracts and interfaces for Kontrol game adapters.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="CHANGELOG.md" Pack="true" PackagePath="\" />
    <Compile Remove="Diagnostics\LegacyAdapterConnectionReporter.cs" />
    <Compile Remove="Diagnostics\LegacyAdapterLogReporter.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <Compile Remove="Compatibility\**\*.cs" />
    <Compile Remove="Interfaces\**\*.cs" />
    <Compile Remove="Inputs\**\*.cs" />
    <Compile Remove="Settings\**\*.cs" />
    <Compile Remove="Telemetry\**\*.cs" />
    <Compile Remove="Diagnostics\AdapterConnectionReporter.cs" />
    <Compile Remove="Diagnostics\AdapterLogReporter.cs" />
    <Compile Remove="Diagnostics\AdapterTraceDescriptor.cs" />
    <Compile Include="Compatibility\NetStandardCompilerServices.cs" />
    <Compile Include="Diagnostics\LegacyAdapterConnectionReporter.cs" />
    <Compile Include="Diagnostics\LegacyAdapterLogReporter.cs" />
  </ItemGroup>

</Project>
