{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://komandio-labs.github.io/kontrol-adapters/schemas/catalog-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalogVersion", "generatedAtUtc", "adapters"],
  "properties": {
    "catalogVersion": { "const": 1 },
    "generatedAtUtc": { "type": "string" },
    "signature": { "type": "string" },
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adapterId", "slug", "displayName", "currentVersion", "releases"],
        "properties": {
          "adapterId": { "type": "string", "minLength": 1 },
          "slug": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string", "minLength": 1 },
          "currentVersion": { "type": "string", "minLength": 1 },
          "releases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["channel", "status"],
              "properties": {
                "channel": { "enum": ["stable", "beta"] },
                "status": { "enum": ["current", "superseded"] }
              }
            }
          }
        }
      }
    }
  }
}
